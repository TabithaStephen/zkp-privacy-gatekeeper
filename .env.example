# Copy to .env (or run `npm run setup`, which generates random values).
# Demo role tokens: at least 32 random characters each. Never commit real values.
ISSUER_API_TOKEN=replace-with-at-least-32-random-characters
VERIFIER_API_TOKEN=replace-with-at-least-32-random-characters

# Optional verifier settings (defaults shown)
# REQUEST_TTL_SECONDS=600
# THRESHOLD_STEP_INR=10000
# VERIFIER_DB_PATH=data/verifier.sqlite
