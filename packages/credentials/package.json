{
  "name": "@zkpg/credentials",
  "version": "0.1.0",
  "private": true,
  "description": "ZKPG_INCOME_V1 credential format: canonical encoding, ECDSA P-256 (low-s) issuer signing and verification",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:circuit": "vitest run --config vitest.circuit.config.ts",
    "keygen": "tsx src/cli/keygen.ts",
    "issue": "tsx src/cli/issue.ts",
    "gen:noir-vectors": "tsx scripts/gen-noir-test-vectors.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
