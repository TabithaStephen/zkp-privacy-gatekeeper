{
  "name": "@zkpg/issuer-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Simulated financial issuer: signs fictional ZKPG_INCOME_V1 credentials (ECDSA P-256)",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zkpg/credentials": "0.1.0",
    "@zkpg/server-security": "0.1.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
