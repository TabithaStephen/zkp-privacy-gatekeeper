{
  "name": "@zkpg/verifier-api",
  "version": "0.1.0",
  "private": true,
  "description": "Independent verifier: creates proof requests and verifies UltraHonk proofs with bb.js",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@zkpg/credentials": "0.1.0",
    "@zkpg/server-security": "0.1.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@noir-lang/noir_js": "1.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
